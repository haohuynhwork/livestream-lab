{
  "name": "livestream-platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n app,rt -c blue,magenta \"vite dev --port 3000 --strictPort\" \"pnpm realtime:dev\"",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "realtime:dev": "tsx watch --tsconfig realtime/tsconfig.json realtime/server.ts",
    "realtime:start": "tsx --tsconfig realtime/tsconfig.json realtime/server.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@livekit/components-react": "^2.9.25",
    "@livekit/components-styles": "^1.2.0",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.5",
    "better-auth": "^1.7.25",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "livekit-client": "^2.24.1",
    "livekit-server-sdk": "^2.19.3",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-tsconfig-paths": "^6.1.1"
  }
}
